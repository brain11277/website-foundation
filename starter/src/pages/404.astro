---
import BaseLayout from '../layouts/BaseLayout.astro';

// noIndex: a 404 should never be in the index, and it is excluded from the
// sitemap automatically because Astro does not emit it as a route.
//
// ⚠️ THIS PAGE ONLY RENDERS IF THE HOST IS TOLD TO USE IT.
// On Cloudflare Workers Assets, `not_found_handling` defaults to "none" and
// every unmatched URL returns an empty-bodied 404 while this file sits in
// dist/ doing nothing. Cloudflare Pages used to detect 404.html on its own;
// Workers deliberately does not. wrangler.jsonc in this starter sets it.
//
// Verify after deploying, rather than trusting it:
//   curl -s -o /dev/null -w '%{http_code} %{size_download}\n' https://yoursite/nope
// A zero byte count means it is still wrong.
---
<BaseLayout
  title="404, page not found"
  description="That page does not exist. It may have moved, or it may never have existed."
  noSuffix
  noIndex
>
  <div class="shell error">
    <h1>404</h1>
    <p class="lede">That page does not exist.</p>

    {/* Echo the path back. A 404 that tells you which URL failed is more
        useful than one that does not, and it costs one expression. */}
    <p class="path"><code>{Astro.url.pathname}</code></p>

    <p class="actions">
      <a href="/">Go home</a>
    </p>
  </div>
</BaseLayout>

<style>
  /*
    `.error`, not `.shell` alone. The 404 wants a narrow, centered, heavily
    padded layout, which is a different intent from the standard content
    container. Overloading the shared class to cover a special case is how a
    container class ends up with three exceptions in it.
  */
  .error {
    max-width: 640px;
    text-align: center;
    padding-top: 40px;
  }

  .error h1 {
    font-size: var(--step-4);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--text-hi);
    margin: 16px auto 24px;
  }

  .path {
    margin: 0 auto 32px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 8px;
    word-break: break-all;
  }

  .actions a {
    display: inline-block;
    padding: 10px 20px;
    background: var(--accent-strong);
    color: var(--on-accent);
    border-radius: 8px;
    font-weight: 500;
  }

  .error p { margin-left: auto; margin-right: auto; }
</style>
